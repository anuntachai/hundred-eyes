# คัดลอกไฟล์นี้เป็น .env.docker แล้วใส่ค่าจริง (สร้าง VAPID ด้วย: npx web-push generate-vapid-keys)
# ใช้กับ: docker compose --env-file .env.docker up -d --build

# ---- Supabase ----
# ใส่โปรเจกต์จริงเมื่อมี หรือคง dummy ไว้เพื่อทดสอบ UI (จะเห็นหน้า onboarding และ error path)
# ถ้ารัน Supabase บนเครื่อง host: ใช้ http://host.docker.internal:54321 (อย่าใช้ localhost)
NEXT_PUBLIC_SUPABASE_URL=https://dummy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=dummy-anon
SUPABASE_SERVICE_ROLE_KEY=dummy-service

# ---- VAPID (Web Push) ----
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ---- Docker ----
APP_PORT=3000
